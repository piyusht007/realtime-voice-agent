# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit your real .env.
# ---------------------------------------------------------------------------

# mock | openai | azure   (mock needs no key and is fully deterministic)
REALTIME_PROVIDER=mock

# --- OpenAI Realtime --------------------------------------------------------
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
# Event protocol header; set empty to use the GA protocol (see README "Compatibility").
OPENAI_BETA_HEADER=realtime=v1

# --- Azure OpenAI Realtime --------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# --- Voice / VAD ------------------------------------------------------------
VOICE=alloy
TRANSCRIPTION_MODEL=whisper-1
VAD_THRESHOLD=0.5
VAD_PREFIX_PADDING_MS=300
VAD_SILENCE_MS=500

# --- Latency prompt (filler) -----------------------------------------------
FILLER_THRESHOLD_MS=700
FILLER_TEXT=One moment while I check that for you.
HANDOFF_FAREWELL_TIMEOUT_S=8

# --- Mock tools / mock realtime --------------------------------------------
MOCK_ORDER_LATENCY_MS=1200
MOCK_CALLBACK_LATENCY_MS=250
MOCK_SPEED=1.0
MOCK_THINK_MS=250

# --- Server -----------------------------------------------------------------
# Optional JSONL mirror of the mock human-agent queue
HANDOFF_QUEUE_PATH=
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
